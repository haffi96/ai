#!/usr/bin/env bash
set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

unit=${2:-customt3code.service}

case ${1:-} in
  latest)
    journalctl --user -u "$unit" --no-pager | grep 'Pairing URL:' | tail -1 | sed -E 's/.*#token=//'
    ;;
  url)
    journalctl --user -u "$unit" --no-pager | grep 'Pairing URL:' | tail -1
    ;;
  restart)
    systemctl --user restart "$unit"
    sleep 4
    journalctl --user -u "$unit" --no-pager | grep 'Pairing URL:' | tail -1
    ;;
  *)
    echo "usage: t3-token latest|url|restart [unit]" >&2
    exit 1
    ;;
esac
